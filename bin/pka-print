#!/usr/bin/env python3
"""
pka-print — Imprimer un document sur l'imprimante EPSON ET-8550 (ou autre) via CUPS.

Convertit proprement en PDF (pandoc + xelatex, gestion CJK + nettoyage des glyphes
non rendus) puis imprime via `lp`. Recto seul par défaut.

Usage :
  pka-print <fichier>                  # imprime recto seul (défaut)
  pka-print <fichier> --duplex         # recto-verso
  pka-print <fichier> --copies 2       # 2 exemplaires
  pka-print <fichier> --printer NAME   # imprimante cible
  pka-print <fichier> --dry-run        # convertit sans imprimer (vérification)
  pka-print --list                     # liste les imprimantes

Formats supportés : .md .txt .docx .html .odt (convertis) ; .pdf (direct).
"""
from __future__ import annotations

import argparse
import subprocess
import sys
import tempfile
from pathlib import Path

PDF_ENGINE = "xelatex"
MAIN_FONT = "Helvetica"
CJK_FONT = "PingFang SC"

# Glyphes souvent absents de Helvetica/AAT — remplacés dans les formats texte
REPLACEMENTS = {
    "🦉": "",
    "→": "->",
    "↔": "<->",
}


def run(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True)


def list_printers() -> list[str]:
    out = run(["lpstat", "-p"]).stdout
    printers = []
    for line in out.splitlines():
        if line.startswith("printer "):
            printers.append(line.split()[1])
    return printers


def default_printer() -> str | None:
    out = run(["lpstat", "-d"]).stdout
    if ":" in out:
        return out.split(":", 1)[1].strip()
    return None


def to_pdf(src: Path) -> Path:
    """Convertit vers un PDF propre ; renvoie le chemin du PDF."""
    suffix = src.suffix.lower()
    if suffix == ".pdf":
        return src  # imprimé directement

    tmpdir = Path(tempfile.mkdtemp(prefix="pka-print-"))
    out_pdf = tmpdir / "out.pdf"

    work = src
    if suffix in (".md", ".txt", ".markdown"):
        text = src.read_text(encoding="utf-8")
        for k, v in REPLACEMENTS.items():
            text = text.replace(k, v)
        work = tmpdir / "cleaned.md"
        work.write_text(text, encoding="utf-8")

    cmd = [
        "pandoc", str(work), "-o", str(out_pdf),
        "--pdf-engine", PDF_ENGINE,
        "-V", f"mainfont={MAIN_FONT}",
        "-V", f"CJKmainfont={CJK_FONT}",
        "-V", "geometry:margin=2.5cm",
    ]
    r = run(cmd)
    if r.returncode != 0:
        sys.stderr.write(r.stderr[-800:])
        raise SystemExit(f"Échec de conversion de {src.name}")
    return out_pdf


def print_file(pdf: Path, printer: str, duplex: bool, copies: int) -> str:
    sides = "two-sided-long-edge" if duplex else "one-sided"
    cmd = ["lp", "-d", printer, "-o", f"sides={sides}", "-n", str(copies), str(pdf)]
    r = run(cmd)
    return (r.stdout or r.stderr).strip()


def main() -> int:
    p = argparse.ArgumentParser(description="Imprimer sur l'EPSON via CUPS")
    p.add_argument("file", nargs="?", help="Fichier à imprimer (.md/.txt/.docx/.html/.odt/.pdf)")
    p.add_argument("--duplex", action="store_true", help="Recto-verso (défaut : recto seul)")
    p.add_argument("--copies", type=int, default=1, help="Nombre d'exemplaires")
    p.add_argument("--printer", help="Imprimante cible (défaut : résolue via lpstat -d)")
    p.add_argument("--dry-run", action="store_true", help="Convertit sans imprimer")
    p.add_argument("--list", action="store_true", help="Liste les imprimantes")
    args = p.parse_args()

    if args.list:
        default = default_printer()
        for pr in list_printers():
            mark = " (défaut)" if pr == default else ""
            print(f"  {pr}{mark}")
        return 0

    if not args.file:
        p.print_help()
        return 1

    src = Path(args.file).expanduser()
    if not src.exists():
        sys.stderr.write(f"Fichier introuvable : {src}\n")
        return 1

    pdf = to_pdf(src)
    printer = args.printer or default_printer() or "EPSON_ET_8550_Series_3"
    mode = "recto-verso" if args.duplex else "recto seul"

    if args.dry_run:
        size = pdf.stat().st_size if pdf.exists() else 0
        print(f"[dry-run] {src.name} -> {pdf.name} ({size} octets) | {printer} | {mode} | {args.copies} copie(s)")
        return 0

    print(f"Imprimante : {printer} | {mode} | {args.copies} copie(s)")
    print(print_file(pdf, printer, args.duplex, args.copies))
    return 0


if __name__ == "__main__":
    sys.exit(main())
