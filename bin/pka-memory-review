#!/usr/bin/env python3
"""
pka-memory-review — Orchestrateur de la boucle mémoire autonome (pattern Hermes).

Referme la boucle que PKA a en pièces détachées (pka_memory_nudge / capture /
generate / prune) en un seul job idempotent et GATED : par défaut, rien n'est
écrit — on produit un rapport de revue stagé que JC approuve (write_approval
équivalent Hermes).

Sous-commandes :
    review   (défaut) Scanner les sessions récentes non capturées → rapport stagé
    skills   Détecter les procédures réutilisables → proposition de SKILL.md stagée
    fts      Indexer les sessions dans team.db (table FTS5 session_fts)
    apply    Appliquer des entrées approuvées du rapport → MEMORY.md (backup avant)

Usage :
    bin/pka-memory-review                          # review, dry-run, stdout + rapport
    bin/pka-memory-review review --since 2026-10-14 --llm
    bin/pka-memory-review skills --llm             # détecter les skills candidats
    bin/pka-memory-review fts                      # indexer les sessions (additif)
    bin/pka-memory-review apply --ids 1,3          # appliquer les entrées 1 et 3

Gating : `review`, `skills` et `fts --dry-run` ne modifient jamais rien.
`apply` sauvegarde MEMORY.md avant toute écriture. `skills --apply` scaffolde
le SKILL.md après approbation.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import shutil
import sqlite3
import sys
import urllib.error
import urllib.request
from datetime import datetime, timedelta
from pathlib import Path

PKA_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Tracing des coûts par appel (P3) — import optionnel, jamais bloquant.
sys.path.insert(0, os.path.join(PKA_ROOT, "scripts"))
try:
    from pka_llm_trace import trace_call  # type: ignore
except ImportError:  # pragma: no cover
    trace_call = None
SESSIONS_DIR = os.path.join(PKA_ROOT, "_local", "sessions")
DB_PATH = os.path.join(PKA_ROOT, "TEAM", "team.db")
MEMORY_PATH = os.path.join(PKA_ROOT, "MEMORY.md")
PERSIST_DIR = os.path.join(PKA_ROOT, "_local", "persist")

# ── Backend LLM (OpenRouter, même mécanique que scripts/qwen.py) ────────────
OPENROUTER_KEY_FILE = Path("~/.config/pka-jch/openrouter_key.txt").expanduser()
OPENROUTER_URL = "https://openrouter.ai/api/v1/chat/completions"
LLM_MODEL_DEFAULT = os.environ.get("PKA_MEMORY_MODEL", "deepseek/deepseek-chat")

# ── Tags projets (détection) ──────────────────────────────────────────────
PROJECT_TAGS = [
    "VETALYX", "DIAHO", "Dixun", "WildNexus", "InsectNet", "NEXUS_ACOUSTIC",
    "Arteon", "WildLens", "L'Instant Lu", "IOT", "Lupo", "RPi", "Home Assistant",
    "Zigbee", "Bluetti", "PHOTO", "TRAVELS", "Van", "dashcam", "graphify",
    "Hermes", "OpenClaw", "MLOps", "team.db", "MEMORY",
]

# Mots-clés décision/fait (repris de pka_memory_nudge.py pour cohérence)
DECISION_KW = [
    "décidé", "décision", "adopté", "validé", "choisi", "on va", "je vais",
    "decided", "decision", "validated", "chosen", "faisons", "go for", "let's",
    "OK pour", "acheté", "reçu", "commandé", "monté",
]
FACT_KW = [
    "JC a", "JCH a", "le setup", "l'IP", "la config", "j'utilise", "j'ai installé",
    "jc uses", "setup is", "configured",
]

# Noms d'outils qui produisent un livrable (fichier touché)
WRITE_TOOLS = {
    "write_file", "edit_file", "apply_patch", "fim_edit",
    "mcp_pka--filesystem_write_file", "mcp_pka--filesystem_edit_file",
}


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


# ── Helpers ────────────────────────────────────────────────────────────────
def load_sessions() -> list[dict]:
    out = []
    for f in glob.glob(os.path.join(SESSIONS_DIR, "*.json")):
        try:
            with open(f, encoding="utf-8") as fh:
                d = json.load(fh)
        except (json.JSONDecodeError, OSError):
            continue
        m = d.get("metadata", {})
        if not m.get("created_at"):
            continue
        m["_file"] = os.path.basename(f)
        d["metadata"] = m
        out.append(d)
    out.sort(key=lambda s: s["metadata"]["created_at"])
    return out


def last_memory_update() -> str:
    """Parse « Dernière mise à jour : YYYY-MM-DD » de MEMORY.md."""
    try:
        with open(MEMORY_PATH, encoding="utf-8") as fh:
            head = fh.read(2000)
        m = re.search(r"Dernière mise à jour\s*:\s*(\d{4}-\d{2}-\d{2})", head)
        if m:
            return m.group(1)
    except OSError:
        pass
    return (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d")


def session_text(session: dict, cap: int = 20000) -> str:
    """Concatène user + assistant text (hors thinking/tool) pour FTS/digest."""
    parts = []
    for msg in session.get("messages", []):
        if msg.get("role") not in ("user", "assistant"):
            continue
        for block in msg.get("content", []):
            if isinstance(block, dict) and block.get("type") == "text":
                parts.append(block.get("text", ""))
    return "\n".join(parts)[:cap]


def files_touched(session: dict) -> list[str]:
    paths = set()
    for msg in session.get("messages", []):
        if msg.get("role") != "assistant":
            continue
        for block in msg.get("content", []):
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use" and block.get("name") in WRITE_TOOLS:
                inp = block.get("input", {})
                p = inp.get("path") or inp.get("changes") or ""
                if isinstance(p, str) and p:
                    paths.add(p)
    return sorted(paths)


def project_tags(text: str) -> list[str]:
    low = text.lower()
    return [t for t in PROJECT_TAGS if t.lower() in low]


def extract_signals(text: str, kws: list[str], cap: int = 8) -> list[str]:
    hits = []
    for line in text.splitlines():
        ll = line.lower()
        if any(k.lower() in ll for k in kws):
            s = line.strip()
            if 8 < len(s) < 400 and s not in hits:
                hits.append(s)
            if len(hits) >= cap:
                break
    return hits


# ── LLM (délégation OpenRouter) ────────────────────────────────────────────
def llm_call(messages: list[dict], model: str, max_tokens: int = 200) -> str | None:
    """Appel chat/completions OpenRouter. Retourne le texte, ou None si échec."""
    if not OPENROUTER_KEY_FILE.exists():
        return None
    key = OPENROUTER_KEY_FILE.read_text(encoding="utf-8").strip()
    if not key:
        return None
    payload = json.dumps({
        "model": model,
        "messages": messages,
        "max_tokens": max_tokens,
        "temperature": 0.2,
    }).encode("utf-8")
    req = urllib.request.Request(
        OPENROUTER_URL,
        data=payload,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
    )
    ctx = trace_call("pka_memory_review", model, "AI_IT_TOOLS") if trace_call else None
    try:
        if ctx:
            t = ctx.__enter__()
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        usage = data.get("usage", {}) or {}
        if ctx:
            t.record(tokens_in=usage.get("prompt_tokens", 0),
                     tokens_out=usage.get("completion_tokens", 0),
                     cost_usd=usage.get("cost", 0.0) or 0.0)
        content = data["choices"][0]["message"].get("content")
        return content.strip() if content else None
    except (urllib.error.HTTPError, urllib.error.URLError, KeyError, IndexError,
            json.JSONDecodeError, OSError) as exc:
        if ctx:
            t.fail(f"{type(exc).__name__}: {exc}")
        return None
    finally:
        if ctx:
            ctx.__exit__(None, None, None)


def llm_summarize(session: dict, model: str) -> str | None:
    """Résume une session en UNE entrée mémoire. None → fallback heuristique."""
    m = session["metadata"]
    text = session_text(session, cap=4000)
    system = (
        "Tu es Dobby, orchestrateur mémoire de PKA_JCH. Résume la session en "
        "UNE seule ligne, format exact : '- [DATE] [TAG — Sujet] : décision ou "
        "fait essentiel (livrable, fichier clé, état final).' Max 30 mots. "
        "Réponds uniquement avec la ligne, sans préambule ni guillemets."
    )
    user = (
        f"Session du {m['created_at'][:10]} — titre : {m.get('title') or '?'} "
        f"({m.get('message_count', 0)} messages).\n\n{text}"
    )
    out = llm_call(
        [{"role": "system", "content": system}, {"role": "user", "content": user}],
        model,
        max_tokens=120,
    )
    if out and out.strip().startswith("- ["):
        return out.strip()
    return None


# ── Review ─────────────────────────────────────────────────────────────────
def cmd_review(since: str, limit: int, as_json: bool, use_llm: bool, model: str) -> int:
    sessions = load_sessions()
    recent = [s for s in sessions if s["metadata"]["created_at"][:10] >= since]
    recent = recent[-limit:] if limit else recent

    entries = []
    for s in recent:
        m = s["metadata"]
        text = session_text(s)
        tags = project_tags(text)
        llm_line = llm_summarize(s, model) if use_llm else None
        entries.append({
            "id": len(entries) + 1,
            "session": m["_file"],
            "date": m["created_at"][:10],
            "title": m.get("title", ""),
            "messages": m.get("message_count", 0),
            "tokens": m.get("total_tokens", 0),
            "cost_usd": round(m.get("cost", {}).get("session_cost_usd", 0.0), 3),
            "model": m.get("model", ""),
            "tags": tags,
            "decisions": extract_signals(text, DECISION_KW),
            "facts": extract_signals(text, FACT_KW),
            "files": files_touched(s),
            "llm_summary": llm_line,
        })

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    report_path = os.path.join(PERSIST_DIR, f"memory-review-{ts}.md")
    os.makedirs(PERSIST_DIR, exist_ok=True)

    method = "LLM (OpenRouter)" if use_llm else "heuristique"
    lines = [
        f"# Memory Review — {datetime.now().strftime('%Y-%m-%d %H:%M')}",
        f"> Boucle mémoire autonome. Sessions depuis **{since}**, non capturées "
        f"dans MEMORY.md (dernière mise à jour : {last_memory_update()}). "
        f"Extraction : **{method}**.",
        "",
        f"**{len(entries)} sessions à revoir.** Rien n'a été écrit — approbation requise.",
        "",
    ]
    for e in entries:
        lines.append(f"## [{e['id']}] {e['date']} — {e['title'] or e['session']}")
        lines.append(f"- Session : `{e['session']}` · {e['messages']} msgs · "
                     f"{e['tokens']:,} tokens · ${e['cost_usd']} · {e['model']}")
        if e["tags"]:
            lines.append(f"- Tags : {', '.join(e['tags'])}")
        if e["llm_summary"]:
            lines.append(f"- **Proposition mémoire (LLM)** : {e['llm_summary']}")
        else:
            if e["decisions"]:
                lines.append("- Décisions détectées (heuristique) :")
                for d in e["decisions"][:3]:
                    lines.append(f"  - {d[:160]}")
        if e["files"]:
            lines.append(f"- Fichiers touchés : {', '.join(e['files'][:6])}")
        lines.append("")

    with open(report_path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))
    log(f"Rapport stagé : {report_path}")

    if as_json:
        jpath = report_path[:-3] + ".json"
        with open(jpath, "w", encoding="utf-8") as fh:
            json.dump({"since": since, "generated": ts, "entries": entries},
                      fh, ensure_ascii=False, indent=2)
        log(f"JSON          : {jpath}")

    print(f"Memory review — {len(entries)} session(s) depuis {since} [{method}]")
    for e in entries:
        tag_s = ",".join(e["tags"])[:36]
        src = "LLM" if e["llm_summary"] else "heur"
        print(f"  [{e['id']}] {e['date']}  {src:4}  {tag_s}")
    return 0


# ── Skills (auto-détection procédures réutilisables) ───────────────────────
def _docstring(filepath: str) -> str:
    """Première ligne de docstring d'un script, sinon ''."""
    try:
        with open(filepath, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith('"""'):
                    m = re.sub(r'^"""\s*', '', line)
                    return m.rstrip('"""').strip()[:160]
                if line and not line.startswith('#'):
                    return line.strip()[:160]
    except OSError:
        pass
    return ""


def cmd_skills(since: str, limit: int, as_json: bool, use_llm: bool, model: str,
               apply_ids: list[int]) -> int:
    sessions = load_sessions()
    recent = [s for s in sessions if s["metadata"]["created_at"][:10] >= since]
    recent = recent[-limit:] if limit else recent

    seen = set()
    pairs = []  # (tool_path, session) — un candidat par outil
    for s in recent:
        for f in files_touched(s):
            if (f.startswith("bin/") or f.startswith("scripts/")
                    or "/bin/" in f or "/scripts/" in f):
                base = os.path.splitext(os.path.basename(f))[0]
                if base not in seen:
                    seen.add(base)
                    pairs.append((f, s))

    candidates = []
    for tool_path, s in pairs:
        skill_name = os.path.splitext(os.path.basename(tool_path))[0]
        desc = _docstring(tool_path)
        if use_llm:
            system = (
                "Tu es Dobby. Un outil réutilisable a été créé. Écris UNE "
                "description de skill en une phrase (ce que fait l'outil, quand le "
                "déclencher). Max 25 mots. Réponds uniquement avec la phrase."
            )
            out = llm_call(
                [{"role": "system", "content": system},
                 {"role": "user", "content": f"Outil : {skill_name} ({tool_path}).\n{desc}"}],
                model, max_tokens=80,
            )
            if out:
                desc = out.strip()
        candidates.append({
            "id": len(candidates) + 1,
            "skill_name": skill_name,
            "session": s["metadata"]["_file"],
            "date": s["metadata"]["created_at"][:10],
            "tools": [tool_path],
            "description": desc,
        })

    if apply_ids:
        return _apply_skills(candidates, apply_ids)

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    path = os.path.join(PERSIST_DIR, f"skill-proposal-{ts}.md")
    os.makedirs(PERSIST_DIR, exist_ok=True)
    lines = [
        f"# Skill Proposal — {datetime.now().strftime('%Y-%m-%d %H:%M')}",
        f"> Détection de procédures réutilisables depuis **{since}**. "
        f"**{len(candidates)} candidat(s).** Rien n'a été créé — approbation requise.",
        "",
    ]
    for c in candidates:
        lines.append(f"## [{c['id']}] skill `{c['skill_name']}` — {c['date']}")
        lines.append(f"- Session : `{c['session']}`")
        lines.append(f"- Outils source : {', '.join(c['tools'])}")
        lines.append(f"- Description proposée : {c['description'] or '—'}")
        lines.append("")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))
    log(f"Proposition stagée : {path}")

    if as_json:
        jpath = path[:-3] + ".json"
        with open(jpath, "w", encoding="utf-8") as fh:
            json.dump({"since": since, "generated": ts, "candidates": candidates},
                      fh, ensure_ascii=False, indent=2)
        log(f"JSON               : {jpath}")

    print(f"Skill proposal — {len(candidates)} candidat(s) depuis {since}")
    for c in candidates:
        print(f"  [{c['id']}] {c['skill_name']:24}  {c['date']}  {c['description'][:50]}")
    return 0


def _apply_skills(candidates: list[dict], ids: list[int]) -> int:
    by_id = {c["id"]: c for c in candidates}
    chosen = [by_id[i] for i in ids if i in by_id]
    if not chosen:
        log(f"Ids invalides. Dispo : {sorted(by_id)}")
        return 1
    for c in chosen:
        # Cible prioritaire : skills/<name>/SKILL.md, sinon .agents/skills
        dest_dir = os.path.join(PKA_ROOT, "skills", c["skill_name"])
        os.makedirs(dest_dir, exist_ok=True)
        dest = os.path.join(dest_dir, "SKILL.md")
        if os.path.exists(dest):
            log(f"Existe déjà, ignoré : {dest}")
            continue
        body = (
            "---\n"
            f"name: {c['skill_name']}\n"
            f"description: {c['description'] or 'Procédure réutilisable PKA.'}\n"
            "---\n\n"
            f"# Skill — {c['skill_name']}\n\n"
            "> Généré par `bin/pka-memory-review skills --apply` (POC). "
            "Corps à compléter par Dobby.\n\n"
            "## Déclencheur\n\n"
            "## Procédure\n\n"
            f"Outils source : {', '.join(c['tools'])}\n"
        )
        with open(dest, "w", encoding="utf-8") as fh:
            fh.write(body)
        log(f"Skill scaffolde : {dest}")
    print(f"Scaffolde {len(chosen)} SKILL.md")
    return 0


# ── FTS ────────────────────────────────────────────────────────────────────
def cmd_fts(dry_run: bool) -> int:
    sessions = load_sessions()
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    existing = {r[0] for r in cur.execute("SELECT session_id FROM session_fts")}
    to_index = [s for s in sessions if s["metadata"]["_file"] not in existing]

    if dry_run:
        print(f"FTS dry-run — {len(existing)} déjà indexés, {len(to_index)} à indexer")
        for s in to_index[:15]:
            print(f"  + {s['metadata']['_file']}")
        conn.close()
        return 0

    n = 0
    for s in to_index:
        m = s["metadata"]
        text = session_text(s)
        tags = ",".join(project_tags(text))
        cur.execute(
            "INSERT INTO session_fts (session_id, date, model, project, content) "
            "VALUES (?, ?, ?, ?, ?)",
            (m["_file"], m["created_at"][:10], m.get("model", ""), tags, text),
        )
        n += 1
    conn.commit()
    conn.close()
    print(f"FTS — {n} session(s) indexée(s) (avant : {len(existing)}, après : {len(existing) + n})")
    return 0


# ── Apply (mémoire) ────────────────────────────────────────────────────────
def cmd_apply(ids: list[int]) -> int:
    reports = sorted(glob.glob(os.path.join(PERSIST_DIR, "memory-review-*.json")))
    if not reports:
        log("Aucun rapport stagé. Lancer d'abord `bin/pka-memory-review`.")
        return 1
    latest = reports[-1]
    with open(latest, encoding="utf-8") as fh:
        data = json.load(fh)
    entries = {e["id"]: e for e in data["entries"]}
    chosen = [entries[i] for i in ids if i in entries]
    if not chosen:
        log(f"Ids invalides. Dispo : {sorted(entries)}")
        return 1

    backup = MEMORY_PATH + f".bak-{datetime.now().strftime('%Y%m%d%H%M%S')}"
    shutil.copy2(MEMORY_PATH, backup)
    log(f"Backup : {backup}")

    with open(MEMORY_PATH, "a", encoding="utf-8") as fh:
        fh.write(f"\n## Session {datetime.now().strftime('%Y-%m-%d')} — Memory Review (auto)\n\n")
        for e in chosen:
            line = e.get("llm_summary")
            if not line:
                line = (f"- [{e['date']}] [Memory Review] : session `{e['session']}` "
                        f"({e['title'] or '—'}) — tags {', '.join(e['tags']) or '—'}. "
                        f"À détailler par Dobby.")
            fh.write(line + "\n")
    print(f"Appliqué {len(chosen)} entrée(s) → MEMORY.md (backup : {backup})")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    r = sub.add_parser("review", help="Scanner les sessions non capturées → rapport stagé")
    r.add_argument("--since", default=None)
    r.add_argument("--limit", type=int, default=None)
    r.add_argument("--json", action="store_true")
    r.add_argument("--llm", action="store_true", help="Résumé par LLM (OpenRouter)")
    r.add_argument("--model", default=LLM_MODEL_DEFAULT)

    s = sub.add_parser("skills", help="Détecter les procédures réutilisables → SKILL.md")
    s.add_argument("--since", default=None)
    s.add_argument("--limit", type=int, default=None)
    s.add_argument("--json", action="store_true")
    s.add_argument("--llm", action="store_true", help="Description de skill par LLM")
    s.add_argument("--model", default=LLM_MODEL_DEFAULT)
    s.add_argument("--apply", dest="apply_ids", help="Ids à scaffolder, ex. 1,3")

    f = sub.add_parser("fts", help="Indexer les sessions dans session_fts (FTS5)")
    f.add_argument("--dry-run", action="store_true")

    a = sub.add_parser("apply", help="Appliquer des entrées approuvées du dernier rapport")
    a.add_argument("--ids", required=True, help="Ids séparés par virgule, ex. 1,3")

    args = p.parse_args()

    if args.cmd == "fts":
        return cmd_fts(args.dry_run)
    if args.cmd == "apply":
        return cmd_apply([int(x) for x in args.ids.split(",") if x.strip().isdigit()])
    if args.cmd == "skills":
        ids = [int(x) for x in args.apply_ids.split(",") if x.strip().isdigit()] \
            if args.apply_ids else []
        return cmd_skills(args.since or last_memory_update(), args.limit, args.json,
                          args.llm, args.model, ids)

    # défaut = review
    since = getattr(args, "since", None) or last_memory_update()
    return cmd_review(since, getattr(args, "limit", None),
                      getattr(args, "json", False), getattr(args, "llm", False),
                      getattr(args, "model", LLM_MODEL_DEFAULT))


if __name__ == "__main__":
    sys.exit(main())
