#!/usr/bin/env bash
# pka-watch-freshness — Vérifie la fraîcheur des State files PKA
# Dobby 🦉 — 2026-07-18 — Automatisation #1
#
# Lance check_state_freshness.py et alerte si CRITICAL.
# Usage:
#   bin/pka-watch-freshness --check    Vérifie et affiche
#   bin/pka-watch-freshness --alert    Alerte si CRITICAL
#   bin/pka-watch-freshness --help

set -euo pipefail

PKA_ROOT="/Users/jchavauxm5/PKA_JCH"
SCRIPT="$PKA_ROOT/scripts/check_state_freshness.py"
LOG="$PKA_ROOT/_local/logs/pka-watch-freshness.log"

MODE="${1:---check}"

if [[ "$MODE" == "--help" || "$MODE" == "-h" ]]; then
  cat <<'EOF'
🩺 pka-watch-freshness — Fraîcheur des State files PKA

USAGE
  bin/pka-watch-freshness --check    Vérifie et affiche le rapport
  bin/pka-watch-freshness --alert    Alerte si ≥1 CRITICAL (>14j)

LAUNCHD
  cp _local/launchd-plists/com.dobby.pka-watch-freshness.plist ~/Library/LaunchAgents/
  launchctl load ~/Library/LaunchAgents/com.dobby.pka-watch-freshness.plist

SEUILS
  >14 jours  🔴 CRITICAL → alerte markdown + notification
  >7 jours   🟡 WARNING  → log seulement
  ≤7 jours   ✅ OK
EOF
  exit 0
fi

if [[ ! -f "$SCRIPT" ]]; then
  echo "❌ Script introuvable : $SCRIPT"
  exit 1
fi

# Exécuter le check
OUTPUT=$(python3 "$SCRIPT" --warn-days 7 2>/dev/null || echo "SCRIPT_ERROR")
CRITICAL_COUNT=$(echo "$OUTPUT" | grep -c '🔴 CRITICAL' 2>/dev/null || echo 0)
WARNING_COUNT=$(echo "$OUTPUT" | grep -c '🟡 WARNING' 2>/dev/null || echo 0)

# Log
mkdir -p "$(dirname "$LOG")"
echo "[$(date -Iseconds)] CRITICAL=$CRITICAL_COUNT WARNING=$WARNING_COUNT" >> "$LOG"

if [[ "$MODE" == "--alert" ]]; then
  if [[ "$CRITICAL_COUNT" -gt 0 ]]; then
    ALERT="$PKA_ROOT/TEAM_Inbox/$(date +%Y-%m-%d)_dobby_watch-freshness-alert.md"
    
    cat > "$ALERT" <<EOF
# 🩺 Alerte fraîcheur State files — $(date +%d/%m/%Y)

## 🔴 CRITICAL (>14 jours sans mise à jour)

$CRITICAL_COUNT fichier(s) périmé(s).

\`\`\`
$(echo "$OUTPUT" | grep -A50 '🔴 CRITICAL' | head -20)
\`\`\`

> Mettre à jour ces fichiers ou les marquer comme archivés.
> Commande : \`python3 scripts/check_state_freshness.py --warn-days 7\`

---
*Généré automatiquement par pka-watch-freshness*
EOF

    # Notification macOS
    osascript -e "display notification \"$CRITICAL_COUNT State files > 14 jours\" with title \"🩺 PKA Freshness\" subtitle \"CRITICAL\" sound name \"Basso\"" 2>/dev/null || true
    
    echo "🔴 $CRITICAL_COUNT CRITICAL — alerte écrite : $ALERT"
  else
    echo "✅ Aucun fichier CRITICAL."
  fi
  exit 0
fi

# Mode --check (défaut)
echo "$OUTPUT"
echo ""
echo "🔴 CRITICAL: $CRITICAL_COUNT | 🟡 WARNING: $WARNING_COUNT"
