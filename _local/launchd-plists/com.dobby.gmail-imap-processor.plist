<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dobby.gmail-imap-processor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/jchavauxm5/PKA_JCH/scripts/gmail_imap_processor.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jchavauxm5/PKA_JCH</string>

    <!-- Tri + routage des mails toutes les 30 minutes (lecture seule, IMAP) -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jchavauxm5/PKA_JCH/_local/logs/gmail-imap-processor.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/jchavauxm5/PKA_JCH/_local/logs/gmail-imap-processor.err</string>
</dict>
</plist>
