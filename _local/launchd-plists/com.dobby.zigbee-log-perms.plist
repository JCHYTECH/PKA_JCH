<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dobby.zigbee-log-perms</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>find /Users/jchavauxm5/PKA_JCH/_local/zigbee2mqtt/log -name '*.log' -perm 0644 -exec chmod 600 {} \; 2>/dev/null; chmod 600 /Users/jchavauxm5/PKA_JCH/_local/zigbee2mqtt/database.db 2>/dev/null</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
