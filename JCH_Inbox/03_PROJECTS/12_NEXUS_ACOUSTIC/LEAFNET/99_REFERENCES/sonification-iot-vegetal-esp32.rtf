## 4. Code Logiciel Optimis\'e9 (C++ Arduino)\
\
### \'c9metteur : Le Capteur Miniature sur Batterie (XIAO ESP32)\
Ce code int\'e8gre des optimisations avanc\'e9es : baisse de la fr\'e9quence CPU \'e0 80MHz, initialisation radio agressive, coupure de l'alimentation de la m\'e9moire flash interne (`VDDSDIO`) et isolation des broches pour \'e9liminer tout courant de fuite visible au PPK2.\
\
```cpp\
#include <esp_now.h>\
#include <WiFi.h>\
#include <esp_wifi.h>\
\
#define TIME_TO_SLEEP  900        // Temps en secondes (900s = 15 minutes)\
#define uS_TO_S_FACTOR 1000000ULL // Facteur de conversion microsecondes -> secondes\
\
const int PIN_ALIM_CAPTEUR = D0;  // Broche d'alimentation du capteur\
const int PIN_SIGNAL_PLANTE = A0; // Broche ADC (Lecture du signal)\
\
// Remplacer par la v\'e9ritable adresse MAC de votre Hub R\'e9cepteur\
uint8_t broadcastAddress[] = \{0x24, 0x0A, 0xC4, 0xXX, 0xXX, 0xXX\};\
\
typedef struct struct_message \{\
  int id;\
  float tensionPlante;\
\} struct_message;\
\
struct_message mesDonnees;\
esp_now_peer_info_t peerInfo;\
\
void setup() \{\
  // OPTIMISATION 1 : R\'e9duire la fr\'e9quence d'horloge (Consomme 2x moins de mA pendant la mesure)\
  setCpuFrequencyMhz(80);\
\
  pinMode(PIN_ALIM_CAPTEUR, OUTPUT);\
  digitalWrite(PIN_ALIM_CAPTEUR, HIGH); // Allumage de l'amplificateur\
  \
  // OPTIMISATION 2 : D\'e9lai minimal de stabilisation \'e0 valider au PPK2\
  delay(15); \
  \
  int valeurBrute = analogRead(PIN_SIGNAL_PLANTE);\
  mesDonnees.tensionPlante = (valeurBrute * 3.3) / 4095.0; // Conversion en Volts (12 bits)\
  mesDonnees.id = 1; // Identifiant du capteur (permet le stacking de plusieurs plantes)\
\
  digitalWrite(PIN_ALIM_CAPTEUR, LOW); // Extinction imm\'e9diate du capteur\
\
  // OPTIMISATION 3 : D\'e9marrage radio rapide pour protocole ESP-NOW (Envoi en < 100ms)\
  WiFi.mode(WIFI_STA);\
  esp_wifi_start(); \
\
  if (esp_now_init() == ESP_OK) \{\
    memcpy(peerInfo.peer_addr, broadcastAddress, 6);\
    peerInfo.channel = 0;  \
    peerInfo.encrypt = false;\
    \
    if (esp_now_add_peer(&peerInfo) == ESP_OK) \{\
      esp_now_send(broadcastAddress, (uint8_t *) &mesDonnees, sizeof(mesDonnees));\
      delay(5); // Temporisation mat\'e9rielle minimale pour finaliser l'\'e9mission\
    \}\
  \}\
\
  entrerEnSommeilProfondUltra();\
\}\
\
void loop() \{\}\
\
void entrerEnSommeilProfondUltra() \{\
  esp_wifi_stop();\
  esp_wifi_deinit();\
\
  // OPTIMISATION 4 : Couper l'alimentation de la m\'e9moire Flash interne en mode sommeil\
  esp_sleep_pd_config(ESP_PD_DOMAIN_VDDSDIO, ESP_PD_OPTION_OFF);\
  \
  // OPTIMISATION 5 : Bloquer l'\'e9tat de la broche pour \'e9viter les fuites de courant vers l'AOP\
  gpio_hold_en((gpio_num_t)PIN_ALIM_CAPTEUR); \
\
  esp_sleep_enable_timer_wakeup(TIME_TO_SLEEP * uS_TO_S_FACTOR);\
  esp_deep_sleep_start();\
\}\
```\
\
### R\'e9cepteur : Le Hub Central (Aliment\'e9 sur Secteur)\
Ce module reste en \'e9coute constante via le protocole ultra-rapide **ESP-NOW**. Il centralise et d\'e9code \'e0 la vol\'e9e les paquets provenant de vos diff\'e9rents capteurs miniatures "stack\'e9s".\
\
```cpp\
#include <esp_now.h>\
#include <WiFi.h>\
\
typedef struct struct_message \{\
  int id;\
  float tensionPlante;\
\} struct_message;\
\
donneesRecues struct_message;\
\
// Fonction ex\'e9cut\'e9e automatiquement \'e0 la r\'e9ception d'un paquet radio\
void OnDataRecv(const esp_now_recv_info_t * recvInfo, const uint8_t *incomingData, int len) \{\
  memcpy(&donneesRecues, incomingData, sizeof(donneesRecues));\
  \
  char macStr[18];\
  snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",\
           recvInfo->src_addr[0], recvInfo->src_addr[1], recvInfo->src_addr[2], \
           recvInfo->src_addr[3], recvInfo->src_addr[4], recvInfo->src_addr[5]);\
\
  Serial.print("Donn\'e9es re\'e7ues du capteur V\'e9g\'e9tal [ID ");\
  Serial.print(donneesRecues.id);\
  Serial.print(" - MAC: ");\
  Serial.print(macStr);\
  Serial.print("] -> Tension mesur\'e9e : ");\
  Serial.print(donneesRecues.tensionPlante, 3);\
  Serial.println(" V");\
\
  // Traitement applicatif (Ex: Envoi MQTT vers Home Assistant ou conversion en Note MIDI)\
  if (donneesRecues.id == 1) \{\
    // Logique pour la plante num\'e9ro 1\
  \}\
\}\
\
void setup() \{\
  Serial.begin(115200);\
  \
  WiFi.mode(WIFI_STA);\
  WiFi.disconnect(); \
\
  if (esp_now_init() != ESP_OK) \{\
    Serial.println("Erreur d'initialisation d'ESP-NOW");\
    return;\
  \}\
  \
  esp_now_register_recv_cb(OnDataRecv);\
  Serial.println("Hub R\'e9cepteur en ligne. En attente des donn\'e9es des plantes...");\
\}\
\
void loop() \{\
  // Rien ici. Tout est g\'e9r\'e9 de mani\'e8re asynchrone par les interruptions mat\'e9rielles.\
\}\
```\
